# 0 represents an empty cell
grid = [
    [5, 3, 0, 0, 7, 0, 0, 0, 0],
    [6, 0, 0, 1, 9, 5, 0, 0, 0],
    [0, 9, 8, 0, 0, 0, 0, 6, 0],
    [8, 0, 0, 0, 6, 0, 0, 0, 3],
    [4, 0, 0, 8, 0, 3, 0, 0, 1],
    [7, 0, 0, 0, 2, 0, 0, 0, 6],
    [0, 6, 0, 0, 0, 0, 2, 8, 0],
    [0, 0, 0, 4, 1, 9, 0, 0, 5],
    [0, 0, 0, 0, 8, 0, 0, 7, 9],
]


def can_place(row, col, number):
    if number in grid[row]:
        return False

    if any(grid[r][col] == number for r in range(9)):
        return False

    box_row = (row // 3) * 3
    box_col = (col // 3) * 3

    for r in range(box_row, box_row + 3):
        for c in range(box_col, box_col + 3):
            if grid[r][c] == number:
                return False

    return True


def solve():
    for row in range(9):
        for col in range(9):
            if grid[row][col] == 0:
                for number in range(1, 10):
                    if can_place(row, col, number):
                        grid[row][col] = number
                        if solve():
                            return True
                        grid[row][col] = 0
                return False
    return True


if solve():
    for row in grid:
        print(*row)
else:
    print("No solution")
